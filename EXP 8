# ============================================================
# IMAGE CLASSIFICATION USING CNN
# Polar Bear vs Walrus
# ============================================================

# ------------------------------------------------------------
# 1. Import libraries
# ------------------------------------------------------------

import tensorflow as tf
import numpy as np
import matplotlib.pyplot as plt

from tensorflow.keras.models import Sequential
from tensorflow.keras.layers import (
    Conv2D,
    MaxPooling2D,
    Flatten,
    Dense,
    Dropout
)

from google.colab import files
import zipfile
import os

# ------------------------------------------------------------
# 2. Upload dataset ZIP
# ------------------------------------------------------------

uploaded = files.upload()

zip_file = list(uploaded.keys())[0]

# Extract ZIP
with zipfile.ZipFile(zip_file, 'r') as zip_ref:
    zip_ref.extractall("/content/dataset")

print("Dataset extracted successfully!")

# ------------------------------------------------------------
# 3. Find dataset directory
# ------------------------------------------------------------

for root, dirs, files_list in os.walk("/content/dataset"):
    if "polar_bear" in dirs and "walrus" in dirs:
        data_dir = root
        break

print("Dataset path:", data_dir)

# ------------------------------------------------------------
# 4. Parameters
# ------------------------------------------------------------

IMG_SIZE = 128
BATCH_SIZE = 32

# ------------------------------------------------------------
# 5. Load training dataset
# ------------------------------------------------------------

train_dataset = tf.keras.utils.image_dataset_from_directory(
    data_dir,
    validation_split=0.20,
    subset="training",
    seed=123,
    image_size=(IMG_SIZE, IMG_SIZE),
    batch_size=BATCH_SIZE
)

# ------------------------------------------------------------
# 6. Load validation dataset
# ------------------------------------------------------------

validation_dataset = tf.keras.utils.image_dataset_from_directory(
    data_dir,
    validation_split=0.20,
    subset="validation",
    seed=123,
    image_size=(IMG_SIZE, IMG_SIZE),
    batch_size=BATCH_SIZE
)

# ------------------------------------------------------------
# 7. Class labels
# ------------------------------------------------------------

class_labels = train_dataset.class_names

print("Class labels:")
print(class_labels)

# ------------------------------------------------------------
# 8. Display training images
# ------------------------------------------------------------

plt.figure(figsize=(12, 8))

for images, labels in train_dataset.take(1):

    for i in range(min(24, len(images))):

        plt.subplot(3, 8, i + 1)

        plt.imshow(
            images[i].numpy().astype("uint8")
        )

        plt.title(
            class_labels[labels[i]]
        )

        plt.axis("off")

plt.tight_layout()
plt.show()

# ------------------------------------------------------------
# 9. Normalize images
# ------------------------------------------------------------

normalization_layer = tf.keras.layers.Rescaling(
    1.0 / 255
)

train_dataset = train_dataset.map(
    lambda x, y: (
        normalization_layer(x),
        y
    )
)

validation_dataset = validation_dataset.map(
    lambda x, y: (
        normalization_layer(x),
        y
    )
)

# ------------------------------------------------------------
# 10. Improve performance
# ------------------------------------------------------------

AUTOTUNE = tf.data.AUTOTUNE

train_dataset = train_dataset.prefetch(
    buffer_size=AUTOTUNE
)

validation_dataset = validation_dataset.prefetch(
    buffer_size=AUTOTUNE
)

# ------------------------------------------------------------
# 11. Create CNN model
# ------------------------------------------------------------

model = Sequential([

    Conv2D(
        32,
        (3, 3),
        activation="relu",
        input_shape=(IMG_SIZE, IMG_SIZE, 3)
    ),

    MaxPooling2D(
        (2, 2)
    ),

    Conv2D(
        64,
        (3, 3),
        activation="relu"
    ),

    MaxPooling2D(
        (2, 2)
    ),

    Conv2D(
        128,
        (3, 3),
        activation="relu"
    ),

    MaxPooling2D(
        (2, 2)
    ),

    Flatten(),

    Dense(
        128,
        activation="relu"
    ),

    Dropout(0.5),

    Dense(
        len(class_labels),
        activation="softmax"
    )
])

# ------------------------------------------------------------
# 12. Compile model
# ------------------------------------------------------------

model.compile(
    optimizer="adam",
    loss="sparse_categorical_crossentropy",
    metrics=["accuracy"]
)

# ------------------------------------------------------------
# 13. Display model summary
# ------------------------------------------------------------

model.summary()

# ------------------------------------------------------------
# 14. Train model
# ------------------------------------------------------------

history = model.fit(
    train_dataset,
    validation_data=validation_dataset,
    epochs=10
)

# ------------------------------------------------------------
# 15. Evaluate model
# ------------------------------------------------------------

loss, accuracy = model.evaluate(
    validation_dataset
)

print("\nTest Loss:", loss)
print("Test Accuracy:", accuracy)

# ------------------------------------------------------------
# 16. Plot accuracy
# ------------------------------------------------------------

plt.figure(figsize=(8, 5))

plt.plot(
    history.history["accuracy"],
    label="Training Accuracy"
)

plt.plot(
    history.history["val_accuracy"],
    label="Validation Accuracy"
)

plt.xlabel("Epoch")
plt.ylabel("Accuracy")

plt.title(
    "Training and Validation Accuracy"
)

plt.legend()

plt.grid(True)

plt.show()

# ------------------------------------------------------------
# 17. Make predictions
# ------------------------------------------------------------

print("\nPredictions:")

for images, labels in validation_dataset.take(1):

    predictions = model.predict(images)

    for i, label in enumerate(class_labels):

        print(
            f"{label}: "
            f"{predictions[0][i]:.4f}"
        )

# ------------------------------------------------------------
# 18. Display one test image
# ------------------------------------------------------------

for images, labels in validation_dataset.take(1):

    image = images[0]

    prediction = model.predict(
        np.expand_dims(image, axis=0)
    )

    predicted_class = np.argmax(
        prediction[0]
    )

    actual_class = labels[0].numpy()

    plt.figure(figsize=(5, 5))

    plt.imshow(image)

    plt.title(
        "Predicted: "
        + class_labels[predicted_class]
        + "\nActual: "
        + class_labels[actual_class]
    )

    plt.axis("off")

    plt.show()

    print(
        "Predicted:",
        class_labels[predicted_class]
    )

    print(
        "Actual:",
        class_labels[actual_class]
    )

# ------------------------------------------------------------
# RESULT
# ------------------------------------------------------------

print("\nResult:")
print(
    "Thus the Python program successfully "
    "implemented image classification using CNN."
)
